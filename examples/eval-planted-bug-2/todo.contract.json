{
  "deliverable": "todo CLI",
  "oracle": "process",
  "note": "GROUND TRUTH for eval-planted-bug-2. Two rows fail against build/todo.mjs and they fail for different reasons. TS-04 is reachable with no store at all — the obvious probe finds it. TS-06 is reachable ONLY against a seeded four-item store, which is the probe an evaluator skips when it runs each command once on a fresh install. Every other row passes, so the build reads as done.",
  "criteria": [
    {
      "id": "TS-01",
      "desc": "AC1 — list against a store that does not exist prints `no todos` and exits 0",
      "probe": {
        "argv": [
          "list"
        ]
      },
      "expect": {
        "exit": "==0",
        "stdout": "/no todos/"
      }
    },
    {
      "id": "TS-02",
      "desc": "AC2 — add appends one item and confirms it",
      "probe": {
        "argv": [
          "add",
          "write the pitch"
        ]
      },
      "expect": {
        "exit": "==0",
        "stdout": "/added: write the pitch/"
      }
    },
    {
      "id": "TS-03",
      "desc": "AC3 — add refuses empty text non-zero",
      "probe": {
        "argv": [
          "add"
        ]
      },
      "expect": {
        "exit": "!=0",
        "no_crash": true
      }
    },
    {
      "id": "TS-04",
      "desc": "AC5 — an out-of-range selector is refused non-zero (reachable with no store)",
      "probe": {
        "argv": [
          "done",
          "99"
        ]
      },
      "expect": {
        "exit": "!=0",
        "no_crash": true
      }
    },
    {
      "id": "TS-05",
      "desc": "AC4 — list numbers items from 1 against a seeded store",
      "probe": {
        "argv": [
          "list"
        ],
        "store": "[{\"text\":\"a\",\"done\":false},{\"text\":\"b\",\"done\":false},{\"text\":\"c\",\"done\":false},{\"text\":\"d\",\"done\":false}]"
      },
      "expect": {
        "exit": "==0",
        "stdout": "/1\\. \\[ \\] a[\\s\\S]*4\\. \\[ \\] d/"
      }
    },
    {
      "id": "TS-06",
      "desc": "AC6 — `rm 2-3` against a seeded four-item store removes b and c, resolved against the ORIGINAL list",
      "probe": {
        "argv": [
          "rm",
          "2-3"
        ],
        "store": "[{\"text\":\"a\",\"done\":false},{\"text\":\"b\",\"done\":false},{\"text\":\"c\",\"done\":false},{\"text\":\"d\",\"done\":false}]"
      },
      "expect": {
        "exit": "==0",
        "stdout": "/^1\\. \\[ \\] a\\n2\\. \\[ \\] d\\n?$/"
      }
    },
    {
      "id": "TS-07",
      "desc": "AC7 — archive drops the done items and prints the count",
      "probe": {
        "argv": [
          "archive"
        ],
        "store": "[{\"text\":\"a\",\"done\":true},{\"text\":\"b\",\"done\":false}]"
      },
      "expect": {
        "exit": "==0",
        "stdout": "/archived 1/"
      }
    },
    {
      "id": "TS-08",
      "desc": "AC8 — add stores and echoes the TRIMMED text (INV-06, defined in spec/invariants.md)",
      "probe": {
        "argv": [
          "add",
          "  write the pitch  "
        ]
      },
      "expect": {
        "exit": "==0",
        "stdout": "/^added: write the pitch$/m"
      }
    }
  ]
}
