# macOS
.DS_Store

# Tier C — project-local, per-member config (design spec addendum §F.7). Templates (*.example)
# ARE committed; the real files are gitignored and never travel with the repo. The env file is
# SHAPEUP_-namespaced (filename + keys) so it never collides with, or gets confused with, the
# target project's own .env / .env.local.
.claude/settings.local.json
.env.shapeup.local
!.env.shapeup.example
!.claude/settings.local.example.json

# Claude Code worktree root. Same tier: a second checkout of THIS repo, per-member and
# per-task. Untracked it shows as `?? .claude/worktrees/` in every status of the main
# checkout, and committed it would nest the repo inside itself.
.claude/worktrees/

# ShapeUp SDLC local workspace (ADR-0001 LOCAL tier): per-slug run trace — board, orders/,
# results/, t0/, evaluation/, qa/, orient/, trace/, discovery/, working/, receipt.json — plus
# the checkout-wide active-scope pointer, decisions.jsonl, safety-overrides.json and metrics/.
# The deliverable (shapeup/ — shaping, spec, contracts, requirements, REPORT.md,
# knowledge-base/) stays tracked; only the hidden local root is ignored.
#
# BOTH roots are listed: migration 0006 renames `.shapeup-sdlc/` → `.shapeup/`, and a run trace
# committed during that window is exactly what the tier split exists to prevent.
.shapeup/
.shapeup-sdlc/

# Day-1 / Day-2 measurement instrument, and its run trace.
#
# What survives under `evals/` is the Tier-2 functional apparatus: the fixture spine and the row
# renderers that `examples/eval-planted-bug-2` drives. The Tier-1 activation datasets, the Day-1
# rubrics and drafts, the Day-2 failure-class register, the three schemas and both baselines were
# removed — so the rules that used to un-ignore them are gone with them rather than left pointing
# at nothing.
#
# `evals/*` rather than `evals/` is load-bearing: git does not descend into an excluded
# DIRECTORY, so a `!` negation under `evals/` can never be reached.
evals/*
!evals/README.md
!evals/oracles/
!evals/fixtures/
!evals/fixtures/**/.shapeup/

# Navigator clone target (gap-scan)
example/

# Compiled distribution artifacts (VS Code extension, Antigravity subagents, Cursor rules)
dist/

 # Python cache                                                                                                   
__pycache__/                                                                                                     
*.pyc 


.playwright-mcp

# plan-executor run workspaces (session-independent, never shipped)
.plan-runs/
