# macOS
.DS_Store

# Tier C — project-local, per-member config (design spec addendum §F.7). Templates (*.example)
# ARE committed; the real files are gitignored and never travel with the repo. The env file is
# SHAPEUP_-namespaced (filename + keys) so it never collides with, or gets confused with, the
# target project's own .env / .env.local.
.claude/settings.local.json
.env.shapeup.local
!.env.shapeup.example
!.claude/settings.local.example.json

# ShapeUp SDLC local workspace (ADR-0001 LOCAL tier): per-slug run trace — board, orders/,
# results/, t0/, evaluation/, qa/, orient/, trace/, discovery/, working/, receipt.json — plus
# the checkout-wide active-scope pointer, decisions.jsonl, safety-overrides.json and metrics/.
# The deliverable (shapeup/ — shaping, spec, contracts, requirements, REPORT.md,
# knowledge-base/) stays tracked; only the hidden local root is ignored.
#
# BOTH roots are listed: migration 0006 renames `.shapeup-sdlc/` → `.shapeup/`, and a run trace
# committed during that window is exactly what the tier split exists to prevent.
.shapeup/
.shapeup-sdlc/

# Navigator clone target (gap-scan)
example/

# Compiled distribution artifacts (VS Code extension, Antigravity subagents, Cursor rules)
dist/

 # Python cache                                                                                                   
__pycache__/                                                                                                     
*.pyc 


.playwright-mcp